# Knexio .htaccess 优化配置
# 用于 Apache 服务器

# ============================================
# 1. 启用 GZIP 压缩
# ============================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  
  # 排除已压缩的文件
  SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|zip|gz)$ no-gzip dont-vary
</IfModule>

# ============================================
# 2. 浏览器缓存策略
# ============================================
<IfModule mod_expires.c>
  ExpiresActive On
  
  # 默认缓存 1 小时
  ExpiresDefault "access plus 1 hour"
  
  # HTML 文件缓存 1 小时（频繁更新）
  ExpiresByType text/html "access plus 1 hour"
  
  # CSS 和 JavaScript 缓存 1 年
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  
  # 图片缓存 1 年
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # 字体缓存 1 年
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
</IfModule>

# ============================================
# 3. 缓存控制头
# ============================================
<IfModule mod_headers.c>
  # HTML 文件：不缓存或缓存 1 小时
  <FilesMatch "\.html?$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
    Header set Pragma "public"
  </FilesMatch>
  
  # CSS 和 JavaScript：缓存 1 年
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set Pragma "public"
  </FilesMatch>
  
  # 图片和字体：缓存 1 年
  <FilesMatch "\.(jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set Pragma "public"
  </FilesMatch>
  
  # JSON 文件：缓存 1 小时
  <FilesMatch "\.json$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# ============================================
# 4. 安全头
# ============================================
<IfModule mod_headers.c>
  # 防止 MIME 类型嗅探
  Header set X-Content-Type-Options "nosniff"
  
  # 防止点击劫持
  Header set X-Frame-Options "SAMEORIGIN"
  
  # 防止 XSS 攻击
  Header set X-XSS-Protection "1; mode=block"
  
  # 引用策略
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  
  # 权限策略
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ============================================
# 5. 启用 HTTP/2
# ============================================
<IfModule mod_http2.c>
  Protocols h2 h2c http/1.1
</IfModule>

# ============================================
# 6. 重定向和 URL 重写
# ============================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # 强制 HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  
  # 移除 www
  RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [L,R=301]
  
  # 移除尾部斜杠（除了目录）
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ https://%{HTTP_HOST}/$1 [L,R=301]
  
  # 处理 404 错误
  ErrorDocument 404 /404.html
</IfModule>

# ============================================
# 7. 禁用目录列表
# ============================================
Options -Indexes

# ============================================
# 8. 设置默认字符编码
# ============================================
AddDefaultCharset UTF-8

# ============================================
# 9. 禁用 ETags（使用 Last-Modified 代替）
# ============================================
<IfModule mod_headers.c>
  Header unset ETag
  FileETag None
</IfModule>

# ============================================
# 10. 优化 AdSense 加载
# ============================================
<FilesMatch "adsbygoogle\.js$">
  Header set Cache-Control "public, max-age=86400"
</FilesMatch>

# ============================================
# 11. 启用 Brotli 压缩（如果可用）
# ============================================
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
